{
  "spec": "test_api/openapi_spec.yaml",
  "endpoint": "http://localhost:8000",
  "base_url": "http://localhost:8000",
  "model": "gemini-2.5-flash",
  "update_spec": false,
  "auth": {
    "type": "client-credentials",
    "client_id": "${API_CLIENT_ID}",
    "client_secret": "${API_CLIENT_SECRET}",
    "token_url": "${API_TOKEN_URL}",
    "token_scope": "${API_TOKEN_SCOPE}",
    "token_audience": "${API_TOKEN_AUDIENCE}"
  },
  "endpoints": [
    {
      "path": "/health",
      "method": "GET"
    },
    {
      "path": "/users/1",
      "method": "GET",
      "status": 200,
      "headers": {
        "X-Request-ID": "test-123"
      },
      "query": {
        "include_metadata": "true"
      }
    },
    {
      "path": "/users",
      "method": "GET",
      "status": 200
    },
    {
      "path": "/users",
      "method": "POST",
      "status": 201,
      "body": {
        "name": "Test User",
        "email": "test@example.com",
        "role": "user"
      },
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "path": "/items/1",
      "method": "GET",
      "query": {
        "currency": "USD"
      }
    },
    {
      "path": "/search",
      "method": "POST",
      "body": {
        "q": "test",
        "limit": 10,
        "offset": 0
      }
    }
  ]
}